# Default for Docker Postgres started by infra/compose.yaml
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/scheduler
# If you run a separate local Postgres instance, override DATABASE_URL as needed.
# If unset, the app falls back to a deterministic stub parser (no LLM call).
GEMINI_API_KEY=
FRONTEND_URL=http://localhost:8000
# Required for Google OAuth. Set a strong random secret.
OAUTH_STATE_SECRET=replace-me-with-a-random-secret
# Required for Google OAuth (calendar sync). If unset, the app shows:
# "OAuth not configured - set env vars"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/google/oauth/callback

# Required for sign-in. Same Google Cloud OAuth client as above, different redirect URI.
GOOGLE_LOGIN_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
# Required for sign-in. Set a strong random secret (different from OAUTH_STATE_SECRET).
SESSION_SECRET=replace-me-with-a-different-random-secret
# Comma-separated emails that get the organizer role on first login, even before a
# team-roster profile exists for them -- bootstraps the first organizer. Everyone else
# must already exist as a user (created by an organizer) to sign in.
ADMIN_EMAILS=
